rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firestore exports. Written by the backup function's service account,
    // which bypasses these rules; no client may ever read or write them.
    // Paths not matched here are denied anyway, but a database export is
    // every student's data in one file, so say it explicitly.
    match /backups/{allPaths=**} {
      allow read, write: if false;
    }

    match /products/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email.matches('^[^@]+@sltc[.]ac[.]lk$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/profile/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email.matches('^[^@]+@sltc[.]ac[.]lk$')
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
