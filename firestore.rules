rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSLTCUser() {
      return isSignedIn() && request.auth.token.email.matches('^[^@]+@sltc[.]ac[.]lk$');
    }

    // Who may post student content. Four of the five admin accounts use
    // gmail addresses, so an SLTC-only check silently stopped admins
    // posting a product, a note, an order or a room request.
    function isCampusMember() {
      return isSLTCUser() || isAdmin();
    }

    function isAdminEmail(email) {
      return email == 'amashanki191@gmail.com'
        || email == 'cit-24-01-0361@sltc.ac.lk'
        || email == 'malshikulasekara4816@gmail.com'
        || email == 'sandupamabimandhi@gmail.com'
        || email == 'jaksikasivakumar@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && isAdminEmail(request.auth.token.email);
    }

    function ownsProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRecruiter() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Recruiter';
    }

    match /jobs/{id} {
      allow read: if isSignedIn();
      allow create: if isRecruiter()
        && request.resource.data.keys().hasOnly(['title', 'company', 'location', 'type',
          'matchPercentage', 'logoUrl', 'recruiterId', 'description', 'requirements',
          'contactEmail', 'postedAt', 'updatedAt'])
        && request.resource.data.recruiterId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 200
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 200
        && request.resource.data.type in ['Full-time', 'Part-time', 'Internship', 'Contract']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 5000
        && request.resource.data.requirements is string
        && request.resource.data.requirements.size() > 0 && request.resource.data.requirements.size() <= 5000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.contactEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && request.resource.data.logoUrl == ''
        && request.resource.data.matchPercentage == 0
        && request.resource.data.postedAt == request.time
        && request.resource.data.updatedAt == request.time;
      // A recruiter may correct the wording of their own vacancy, but not
      // reassign it, backdate it, or set the match score students see. The
      // create rule pins matchPercentage to 0; without the same limit on
      // update, any recruiter could edit their job to claim a 100% match.
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.recruiterId || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'company', 'location', 'type', 'description',
          'requirements', 'contactEmail', 'updatedAt'
        ])
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() <= 200
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 200
        && request.resource.data.type in ['Full-time', 'Part-time', 'Internship', 'Contract']
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.requirements.size() > 0
        && request.resource.data.requirements.size() <= 5000
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.recruiterId || isAdmin());
    }

    function isOwnerOrAdmin(resourceOwnerId) {
      return isSignedIn() && (request.auth.uid == resourceOwnerId || isAdmin());
    }

    // All transitions and scheduling are server-owned callable transactions.
    match /lostFound/{itemId} {
      allow read: if isSignedIn() && (resource.data.status == 'active'
        || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /users/{uid}/notifications/{notificationId} {
      allow read: if ownsProfile(uid);
      allow write: if false;
    }

    // Campus notice board: everyone signed in reads, only admins write.
    match /notices/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'category',
          'pinned', 'postedBy', 'postedAt', 'imageUrl', 'caption'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1500
        && request.resource.data.category in
          ['Academic', 'Events', 'Facilities', 'Exams', 'General']
        && request.resource.data.pinned is bool
        && request.resource.data.postedBy is string
        && request.resource.data.postedBy.size() <= 200
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 140
        && request.resource.data.postedAt == request.time;
      allow update, delete: if isAdmin();
    }

    // App feedback: signed-in users submit their own reports; admins review
    // and remove feedback from the admin moderation panel.
    match /feedback/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'category', 'rating', 'message', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.category in ['Bug report', 'Idea', 'Other']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Campus event tickets: everyone signed in browses, only admins publish.
    // Delete is plain isAdmin() with no further condition, so an admin can
    // pull an event at any time -- including after it has been published and
    // after the event date has passed.
    match /tickets/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'details', 'price',
          'imageUrl', 'postedBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 200
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 40
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.postedBy is string
        && request.resource.data.postedBy.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Students may suggest campus events, but suggestions stay private to
    // admins until the admin panel approves and publishes them as tickets.
    match /eventSubmissions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'details', 'price', 'imageUrl', 'submitterUid',
          'submitterEmail', 'submittedAt', 'status'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 200
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 40
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.submitterUid == request.auth.uid
        && request.resource.data.submitterEmail == request.auth.token.email
        && request.resource.data.submittedAt == request.time
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Canteen orders: a student reads and places their own; nobody else's.
    match /foodOrders/{id} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isCampusMember()
        && request.resource.data.keys().hasOnly(['userId', 'restaurantName',
          'lines', 'total', 'status', 'note', 'collectionCode', 'placedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() > 0
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 40
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.status == 'Placed'
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.collectionCode is string
        && request.resource.data.placedAt == request.time;
      // Only an admin moves an order along; a student cannot mark it Ready.
      allow update, delete: if isAdmin();
    }

    // Hostel room requests: a student submits and reads their own.
    match /hostelBookings/{id} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isCampusMember()
        && request.resource.data.keys().hasOnly(['userId', 'hostel',
          'roomNumber', 'floor', 'sharing', 'monthlyPrice', 'checkIn',
          'checkOut', 'status', 'reference', 'requestedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.hostel is string
        && request.resource.data.hostel.size() > 0
        && request.resource.data.roomNumber is string
        && request.resource.data.roomNumber.size() > 0
        && request.resource.data.roomNumber.size() <= 10
        && request.resource.data.floor is string
        && request.resource.data.sharing in [4, 6]
        && request.resource.data.monthlyPrice is int
        && request.resource.data.monthlyPrice > 0
        && request.resource.data.checkIn is timestamp
        && request.resource.data.checkOut is timestamp
        && request.resource.data.checkOut > request.resource.data.checkIn
        // 90 nights, matching HostelBookingService.maxNights. Without this
        // the client was the only thing stopping a ten-year request.
        && request.resource.data.checkOut
             < request.resource.data.checkIn + duration.value(90, 'd')
        // A student submits a request; only an admin confirms it.
        && request.resource.data.status == 'Requested'
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 12
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if isSignedIn();
      allow create: if isCampusMember()
        && request.resource.data.keys().hasOnly(['title', 'category', 'price',
          'description', 'imageUrl', 'sellerId', 'sellerName', 'createdAt'])
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.category in ['Books', 'Electronics', 'Other']
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() <= 200
        && request.resource.data.createdAt == request.time;
      // A seller may edit their listing but not hand it to someone else or
      // backdate it, and the same length caps apply as on create.
      allow update: if isOwnerOrAdmin(resource.data.sellerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'price', 'description', 'imageUrl'
        ])
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.category in ['Books', 'Electronics', 'Other']
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.imageUrl.size() <= 500;
      allow delete: if isOwnerOrAdmin(resource.data.sellerId);
    }

    match /notes/{id} {
      allow read: if isSignedIn();
      allow create: if isCampusMember()
        && request.resource.data.keys().hasOnly(['title', 'subject', 'description', 'fileType',
          'fileUrl', 'ownerId', 'uploadedDate', 'createdAt', 'degree', 'topic'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 100
        && request.resource.data.fileType is string
        && request.resource.data.fileType.size() <= 20
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.size() <= 500
        && request.resource.data.createdAt == request.time;
      // The owner may correct the details but not reassign the note or
      // backdate it.
      allow update: if isOwnerOrAdmin(resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'subject', 'description', 'fileType', 'fileUrl',
          'degree', 'topic', 'uploadedDate'
        ])
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description.size() <= 2000
        && request.resource.data.fileUrl.size() <= 500;
      allow delete: if isOwnerOrAdmin(resource.data.ownerId);
    }

    match /users/{uid} {
      // Shape every profile write must satisfy, whoever makes it.
      function validProfile() {
        return request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'birthday', 'year', 'faculty', 'district', 'image',
            'blocked', 'updatedAt'
          ])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.role in ['Student', 'Recruiter']
          && request.resource.data.get('faculty', '') is string
          && request.resource.data.get('faculty', '').size() <= 200
          && (isSLTCUser() || isAdmin() || request.resource.data.role == 'Recruiter')
          && request.resource.data.updatedAt == request.time;
      }

      // Admins list every account in the admin panel; students see only their
      // own profile.
      allow read: if ownsProfile(uid) || isAdmin();

      // Nobody signs themselves up pre-blocked.
      allow create: if ownsProfile(uid) && validProfile()
        && request.resource.data.get('blocked', false) == false;

      // The owner may edit their profile but never their own blocked flag.
      allow update: if ownsProfile(uid) && validProfile()
        && request.resource.data.get('blocked', false)
           == resource.data.get('blocked', false);

      // An admin may flip the blocked flag and nothing else. Admin accounts
      // themselves cannot be blocked, so the panel can never lock every
      // administrator out.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['blocked', 'updatedAt'])
        && request.resource.data.blocked is bool
        && !isAdminEmail(resource.data.email);
    }
  }
}
