rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSLTCUser() {
      return isSignedIn() && request.auth.token.email.matches('^[^@]+@sltc[.]ac[.]lk$');
    }

    function isAdminEmail(email) {
      return email == 'amashanki191@gmail.com'
        || email == 'cit-24-01-0361@sltc.ac.lk'
        || email == 'malshikulasekara4816@gmail.com'
        || email == 'sandupamabimandhi@gmail.com'
        || email == 'jaksikasivakumar@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && isAdminEmail(request.auth.token.email);
    }

    function ownsProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRecruiter() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Recruiter';
    }

    match /jobs/{id} {
      allow read: if isSignedIn();
      allow create: if isRecruiter()
        && request.resource.data.keys().hasOnly(['title', 'company', 'location', 'type',
          'matchPercentage', 'logoUrl', 'recruiterId', 'description', 'requirements',
          'contactEmail', 'postedAt', 'updatedAt'])
        && request.resource.data.recruiterId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 200
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 200
        && request.resource.data.type in ['Full-time', 'Part-time', 'Internship', 'Contract']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 5000
        && request.resource.data.requirements is string
        && request.resource.data.requirements.size() > 0 && request.resource.data.requirements.size() <= 5000
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.contactEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && request.resource.data.logoUrl == ''
        && request.resource.data.matchPercentage == 0
        && request.resource.data.postedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if isSignedIn()
        && (request.auth.uid == resource.data.recruiterId || isAdmin());
    }

    function isOwnerOrAdmin(resourceOwnerId) {
      return isSignedIn() && (request.auth.uid == resourceOwnerId || isAdmin());
    }

    // All transitions and scheduling are server-owned callable transactions.
    match /lostFound/{itemId} {
      allow read: if isSignedIn() && (resource.data.status == 'active'
        || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /users/{uid}/notifications/{notificationId} {
      allow read: if ownsProfile(uid);
      allow write: if false;
    }

    match /products/{id} {
      allow read: if isSignedIn();
      allow create: if isSLTCUser()
        && request.resource.data.keys().hasOnly(['title', 'category', 'price',
          'description', 'imageUrl', 'sellerId', 'sellerName', 'createdAt'])
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.category in ['Books', 'Electronics', 'Other']
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.description is string
        && request.resource.data.imageUrl is string
        && request.resource.data.sellerName is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwnerOrAdmin(resource.data.sellerId);
    }

    match /notes/{id} {
      allow read: if isSignedIn();
      allow create: if isSLTCUser()
        && request.resource.data.keys().hasOnly(['title', 'subject', 'description', 'fileType',
          'fileUrl', 'ownerId', 'uploadedDate', 'createdAt', 'degree', 'topic'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.fileType is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwnerOrAdmin(resource.data.ownerId);
    }

    match /users/{uid} {
      // Shape every profile write must satisfy, whoever makes it.
      function validProfile() {
        return request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'birthday', 'year', 'district', 'image',
            'blocked', 'updatedAt'
          ])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.role in ['Student', 'Recruiter']
          && (isSLTCUser() || isAdmin() || request.resource.data.role == 'Recruiter')
          && request.resource.data.updatedAt == request.time;
      }

      // Admins list every account in the admin panel; students see only their
      // own profile.
      allow read: if ownsProfile(uid) || isAdmin();

      // Nobody signs themselves up pre-blocked.
      allow create: if ownsProfile(uid) && validProfile()
        && request.resource.data.get('blocked', false) == false;

      // The owner may edit their profile but never their own blocked flag.
      allow update: if ownsProfile(uid) && validProfile()
        && request.resource.data.get('blocked', false)
           == resource.data.get('blocked', false);

      // An admin may flip the blocked flag and nothing else. Admin accounts
      // themselves cannot be blocked, so the panel can never lock every
      // administrator out.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['blocked', 'updatedAt'])
        && request.resource.data.blocked is bool
        && !isAdminEmail(resource.data.email);
    }
  }
}
